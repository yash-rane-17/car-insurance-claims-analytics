      <column caption='Income Group' datatype='string' name='[Calculation_0174590552944640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [INCOME] &lt; 30000 THEN &quot;Low Income&quot;&#13;&#10;ELSEIF [INCOME] &lt; 70000 THEN &quot;Middle Income&quot;&#13;&#10;ELSE &quot;High Income&quot;&#13;&#10;END' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_0638585481154560]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1257609156284416] &lt; 30 THEN &quot;Under 30&quot;&#13;&#10;ELSEIF [Calculation_1257609156284416] &lt; 50 THEN &quot;30-49&quot;&#13;&#10;ELSEIF [Calculation_1257609156284416] &lt; 70 THEN &quot;50-69&quot;&#13;&#10;ELSE &quot;70+&quot;&#13;&#10;END' />
      </column>
      <column caption='Claim filter logic' datatype='boolean' name='[Calculation_0638585487015937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 2] = &quot;All Drivers&quot;&#13;&#10;OR&#13;&#10;([Parameters].[Parameter 2] = &quot;Claimers Only&quot; AND [CLM_FREQ] &gt; 0)&#13;&#10;OR&#13;&#10;([Parameters].[Parameter 2] = &quot;Non-Claimers Only&quot; AND [CLM_FREQ] = 0)' />
      </column>
      <column caption='Age' datatype='integer' name='[Calculation_1257609156284416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [BIRTH], TODAY())' />
      </column>
